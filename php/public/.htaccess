Options -Indexes
DirectoryIndex index.html index.php

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  # La API (complemento, panel y portal) la atiende index.php; las páginas estáticas las sirve Apache.
  RewriteRule ^(api/v1|admin/api|portal/api)(/|$) index.php [L]
</IfModule>
